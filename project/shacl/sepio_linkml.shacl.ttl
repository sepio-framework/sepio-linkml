example:sepio-model\/InformationEntity a sh:NodeShape ;
	rdfs:comment "An abstract (non-physical) entity that is about something - representing the underlying 'information content' conveyed by physical or digital information artifacts like books, web pages, data tables, or photographs." ;
	rdfs:label "Information Entity" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n200 ;
