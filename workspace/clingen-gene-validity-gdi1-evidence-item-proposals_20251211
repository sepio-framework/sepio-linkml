# 1.  Variant Observation Evidence

# Original ClinGen Data
{
  "id": "https://genegraph.clinicalgenome.org/r/f13b920a-fcce-4133-a04b-24d8ffafcaae_variant_evidence_item",
  "type": "VariantObservation",              # Currently no model of "Observations" in SEPIO/VA, but this has been explored and can be added. Or use a Study Result. 
  "dc:source": "https://pubmed.ncbi.nlm.nih.gov/22002931",
  "allele": {                                # Is this intended to be a GA4GH VRS allele object? Seems to use outdated 'Descriptor' modeling.
    "id": "https://genegraph.clinicalgenome.org/r/b152381d-b705-4ef5-93ba-bfd27d966769",
    "type": "https://terms.ga4gh.org/VariationDescriptor",
    "http://www.w3.org/2004/02/skos/core#prefLabel": "NM_001493.3(GDI1):c.1186_1187del (p.Ser396ProfsTer15)",
    "https://terms.ga4gh.org/CanonicalReference": {
      "id": "https://www.ncbi.nlm.nih.gov/clinvar/variation/29933"
    }
  },
  "alleleOrigin": {
    "id": "cg:GermlineAlleleOrigin"
  },
  "zygosity": {
    "id": "cg:Hemizygous"
  }
}
            
# Matt's SEPIO Proposal 1: Representation as a Study Result with the allele as the "focus" (considers individual variant observations to be "micro studies" on a study group with 1 member - mainly becuase the StudyResult structure and profiling rules align with this use case)
  "id": "https://genegraph.clinicalgenome.org/r/f13b920a-fcce-4133-a04b-24d8ffafcaae_variant_evidence_item",
  "type": "SingleVariantObservationStudyResult",                 # Create a subtype/profile for a specific type of observation as a Study Result
  "reportedIn": "https://pubmed.ncbi.nlm.nih.gov/22002931",
  "focus": {                                         # Should use current VRS Allele model                             
    "id": "https://genegraph.clinicalgenome.org/r/b152381d-b705-4ef5-93ba-bfd27d966769",
    "type": "https://terms.ga4gh.org/VariationDescriptor",
    "http://www.w3.org/2004/02/skos/core#prefLabel": "NM_001493.3(GDI1):c.1186_1187del (p.Ser396ProfsTer15)",
    "https://terms.ga4gh.org/CanonicalReference": {
      "id": "https://www.ncbi.nlm.nih.gov/clinvar/variation/29933"
    }
  },
  "alleleObserved": TRUE                           # Could use a boolean property to report the variant was observed or not . . . or a enumerated property if want to say yes, no, not determined, etc. 
  "alleleOrigin": {
    "id": "cg:GermlineAlleleOrigin"
  },
  "alleleZygosity": {
    "id": "cg:Hemizygous"
  },
  "studyGroup": {a participant/person id could go here? if we wanted to capture this)
}

# Matt's SEPIO Prposal 2: Representation as a Study Result with the study participant as the "focus"
# This could allow for multiple observed variants to be reported in one Result. This structure could be applied to phenotype observations as well.
# But Tristan says he would ahve to capture one variant per study Result anyway, as they are scored independently. 
  "id": "https://genegraph.clinicalgenome.org/r/f13b920a-fcce-4133-a04b-24d8ffafcaae_variant_evidence_item",
  "type": "ObservationVariantStudyResult",                 # Create a subtype/profile for a specific type of observation as a Study Result
  "reportedIn": "https://pubmed.ncbi.nlm.nih.gov/22002931",
  "focus": https://genegraph.clinicalgenome.org/r/24b132c6-bcfd-4b3d-b24e-44591b9e8755",    # a participant
  "observedAlleles":  [                            # Takes one or more "ObservedVariant" objects - a domain entity class we would need to define to represent variants as observed in a particular patient. 
     {
     "id": "https://genegraph.clinicalgenome.org/r/b24gra-eab3425-a045-24baae84afcaaee_variant"
     "type": "ObservedVariant"
     "variant": "https://genegraph.clinicalgenome.org/r/b152381d-b705-4ef5-93ba-bfd27d966769",
     "variantOrigin": "cg:GermlineAlleleOrigin",
     "variantZygosity": "cg:Hemizygous"
     }
   ]
  "studyGroup": {a participant/person id could go here? if we wanted to capture this)
}


