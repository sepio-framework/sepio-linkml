# metamodel_version: 1.12.0
BASE <https://w3id.org/sepio-framework/sepio-linkml/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<Activity>  (
    CLOSED {
       (  $<Activity_tes> (  &<Entity_tes> ;
             rdf:type [ <http://purl.obolibrary.org/obo/BFO_0000001> ] ? ;
             <subtype> @<Coding> ? ;
             <http://purl.obolibrary.org/obo/SEPIO_0000160> @linkml:Date ? ;
             <http://purl.obolibrary.org/obo/SEPIO_0000017> @<Agent> * ;
             <http://purl.obolibrary.org/obo/SEPIO_0000041> @<Method> * ;
             <http://purl.obolibrary.org/obo/OBI_0000293> @<Entity> * ;
             <http://purl.obolibrary.org/obo/OBI_0000299> @<Entity> *
          ) ;
          rdf:type [ prov:Activity ] ?
       )
    } OR @<Contribution>
)

<Agent> CLOSED {
    (  $<Agent_tes> (  &<Entity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/BFO_0000001> ] ? ;
          <subtype> @linkml:String ? ;
          <name> @linkml:String ?
       ) ;
       rdf:type [ prov:Agent ] ?
    )
}

<Characteristic> CLOSED {
    (  $<Characteristic_tes> (  &<Utility_tes> ;
          rdf:type [ <Utility> ] ? ;
          <name> @linkml:String ;
          <values> @linkml:String + ;
          <value_operator> @linkml:String ?
       ) ;
       rdf:type [ <Characteristic> ] ?
    )
}

<Coding> CLOSED {
    (  $<Coding_tes> (  &<Utility_tes> ;
          rdf:type [ <Utility> ] ? ;
          <code> @linkml:String ? ;
          <label> @linkml:String ? ;
          <system> @linkml:String ? ;
          <system_version> @linkml:String ?
       ) ;
       rdf:type [ <Coding> ] ?
    )
}

<Contribution> CLOSED {
    (  $<Contribution_tes> (  &<Activity_tes> ;
          rdf:type [ prov:Activity ] ? ;
          <contributor> @<Agent> ? ;
          <activity_type> @<Coding> * ;
          <http://purl.obolibrary.org/obo/SEPIO_0000188> @<InformationEntity> ?
       ) ;
       rdf:type [ <http://purl.obolibrary.org/obo/SEPIO_0000158> ] ?
    )
}

<DataItem> CLOSED {
    (  $<DataItem_tes> (  &<InformationEntity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000030> ] ? ;
          <subtype> @<Coding> ? ;
          <value> @linkml:String ;
          <unit> @<Coding> ? ;
          <variability_measures> @<DataItem> * ;
          <confidence_interval> @<DataItem> ? ;
          <component_data_item> @<DataItem> *
       ) ;
       rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000027> ] ?
    )
}

<DataSet> CLOSED {
    (  $<DataSet_tes> (  &<InformationEntity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000030> ] ? ;
          <subtype> @<Coding> ? ;
          <release_date> @linkml:String ? ;
          <version> @linkml:String ? ;
          <license> @linkml:String ?
       ) ;
       rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000100> ] ?
    )
}

<Document> CLOSED {
    (  $<Document_tes> (  &<InformationEntity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000030> ] ? ;
          <subtype> @<Coding> ? ;
          <title> @linkml:String ? ;
          <urls> @linkml:String * ;
          <pmid> @linkml:String ? ;
          <doi> @linkml:String ? ;
          <license> @linkml:String ?
       ) ;
       rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000310> ] ?
    )
}

<Entity>  (
    CLOSED {
       (  $<Entity_tes> (  <id> @linkml:String ;
             <identifiers> @linkml:String * ;
             <type> @linkml:String ;
             <label> @linkml:String ? ;
             <alternative_labels> @linkml:String * ;
             <description> @linkml:String ? ;
             <extensions> @<Extension> *
          ) ;
          rdf:type [ <http://purl.obolibrary.org/obo/BFO_0000001> ] ?
       )
    } OR @<Activity> OR @<Agent> OR @<InformationEntity> OR @<Proposition> OR @<StudyGroup>
)

<EvidenceLine> CLOSED {
    (  $<EvidenceLine_tes> (  &<InformationEntity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000030> ] ? ;
          <subtype> @<Coding> ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000427> @<Proposition> ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000084> @<InformationEntity> * ;
          <http://purl.obolibrary.org/obo/SEPIO_0000183> [ <http://purl.obolibrary.org/obo/SEPIO_0000403>
             <http://purl.obolibrary.org/obo/SEPIO_0000404> <http://purl.obolibrary.org/obo/SEPIO_0000405> ] ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000132> @linkml:Uriorcurie ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000429> @linkml:Float ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000124> @linkml:Uriorcurie *
       ) ;
       rdf:type [ <http://purl.obolibrary.org/obo/SEPIO_0000002> ] ?
    )
}

<Expression> CLOSED {
    (  $<Expression_tes> (  &<Utility_tes> ;
          rdf:type [ <Utility> ] ? ;
          <value> @linkml:String ;
          <system_url> @linkml:Uriorcurie ? ;
          <system_version> @linkml:String ?
       ) ;
       rdf:type [ <Expression> ] ?
    )
}

<Extension> CLOSED {
    (  $<Extension_tes> (  &<Utility_tes> ;
          rdf:type [ <Utility> ] ? ;
          <extension_description> @linkml:String ? ;
          <name> @linkml:String ;
          <value> @linkml:String
       ) ;
       rdf:type [ <Extension> ] ?
    )
}

<InformationEntity>  (
    CLOSED {
       (  $<InformationEntity_tes> (  &<Entity_tes> ;
             rdf:type [ <http://purl.obolibrary.org/obo/BFO_0000001> ] ? ;
             <http://purl.obolibrary.org/obo/IAO_0000136> @linkml:Uriorcurie * ;
             <http://purl.obolibrary.org/obo/SEPIO_0000159> @<Contribution> * ;
             <http://purl.obolibrary.org/obo/SEPIO_0000135> @linkml:String ? ;
             <http://purl.obolibrary.org/obo/SEPIO_0000041> @linkml:Uriorcurie * ;
             <supporting_methods> @linkml:String * ;
             <supporting_method_types> @<Coding> * ;
             <derived_from> @<InformationEntity> * ;
             <http://purl.obolibrary.org/obo/SEPIO_0000108> @linkml:Uriorcurie * ;
             <sources> @linkml:String * ;
             <http://purl.obolibrary.org/obo/SEPIO_0000415> @<Coding> ? ;
             <record_metadata> @<RecordMetadata> ?
          ) ;
          rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000030> ] ?
       )
    } OR @<DataItem> OR @<DataSet> OR @<Document> OR @<EvidenceLine> OR @<Method> OR @<Statement> OR @<StudyResult>
)

<Method> CLOSED {
    (  $<Method_tes> (  &<InformationEntity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000030> ] ? ;
          <subtype> @<Coding> ? ;
          <urls> @linkml:String *
       ) ;
       rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000104> ] ?
    )
}

<Proposition> CLOSED {
    (  $<Proposition_tes> (  &<Entity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/BFO_0000001> ] ? ;
          <proposition_text> @linkml:String ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000388> @linkml:Uriorcurie ;
          <http://purl.obolibrary.org/obo/SEPIO_0000389> @<Coding> ;
          <http://purl.obolibrary.org/obo/SEPIO_0000390> @linkml:Uriorcurie ;
          <http://purl.obolibrary.org/obo/SEPIO_0000144> @<Qualifier> * ;
          <negated> @linkml:Boolean ?
       ) ;
       rdf:type [ <http://purl.obolibrary.org/obo/SEPIO_0000000> ] ?
    )
}

<Qualifier> CLOSED {
    (  $<Qualifier_tes> (  &<Utility_tes> ;
          rdf:type [ <Utility> ] ? ;
          <name> @linkml:String ;
          <value> @linkml:String
       ) ;
       rdf:type [ <Qualifier> ] ?
    )
}

<RecordMetadata> CLOSED {
    (  $<RecordMetadata_tes> (  &<Utility_tes> ;
          rdf:type [ <Utility> ] ? ;
          <record_identifier> @linkml:String ? ;
          <record_version> @linkml:String ? ;
          <derived_from_record> @linkml:String * ;
          <http://purl.obolibrary.org/obo/SEPIO_0000436> @linkml:String ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000159> @<Contribution> *
       ) ;
       rdf:type [ <RecordMetadata> ] ?
    )
}

<Statement> CLOSED {
    (  $<Statement_tes> (  &<InformationEntity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000030> ] ? ;
          <statement_text> @linkml:String ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000030> @<Proposition> ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000388> @linkml:Uriorcurie ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000389> @<Coding> ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000390> @linkml:Uriorcurie ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000144> @<Qualifier> * ;
          <direction> @linkml:String ? ;
          <strength> @linkml:String ? ;
          <score> @linkml:Float ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000197> @<Coding> ? ;
          <http://purl.obolibrary.org/obo/SEPIO_0000398> @linkml:Uriorcurie * ;
          <http://purl.obolibrary.org/obo/SEPIO_0000006> @<EvidenceLine> * ;
          <http://purl.obolibrary.org/obo/SEPIO_0000189> @<InformationEntity> * ;
          <http://purl.obolibrary.org/obo/SEPIO_0000145> @<InformationEntity> *
       ) ;
       rdf:type [ <http://purl.obolibrary.org/obo/SEPIO_0000001> ] ?
    )
}

<StudyGroup> CLOSED {
    (  $<StudyGroup_tes> (  &<Entity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/BFO_0000001> ] ? ;
          <member_count> @linkml:Integer ? ;
          <is_subset_of> @<StudyGroup> * ;
          <characteristics> @<Characteristic> *
       ) ;
       rdf:type [ <StudyGroup> ] ?
    )
}

<StudyResult> CLOSED {
    (  $<StudyResult_tes> (  &<InformationEntity_tes> ;
          rdf:type [ <http://purl.obolibrary.org/obo/IAO_0000030> ] ? ;
          <focus> @linkml:String ? ;
          <data_items> @<DataItem> * ;
          <interpretation> @<Coding> ? ;
          <source_data_set> @<DataSet> * ;
          <component_result> @<StudyResult> * ;
          <study_group> @<StudyGroup> ?
       ) ;
       rdf:type [ <StudyResult> ] ?
    )
}

<Utility>  (
    CLOSED {
       (  $<Utility_tes> rdf:type . * ;
          rdf:type [ <Utility> ] ?
       )
    } OR @<Characteristic> OR @<Coding> OR @<Expression> OR @<Extension> OR @<Qualifier> OR @<RecordMetadata>
)
