# 3. FamilyCosegregation Evidence

# Original ClinGen Data:
# Question: is there a need to capture the variant/allele that is being tracked as well?

{
  "id": "https://genegraph.clinicalgenome.org/r/0087c979-8cb6-4959-bc64-07a48a61983b_family_segregation",
  "type": "FamilyCosegregation",              # This (and all similar objects below) would likely be representable by a new SEPIO/VA StudyResult subtype, which we could define to capture the info below
  "dc:description": "Sequenced more than 1 gene on the X, higher than just candidate gene sequencing",
  "dc:source": "https://pubmed.ncbi.nlm.nih.gov/22002931",
  "rdfs:label": "Strobl-Wildemann - Segregation Scoring",
  "family": {
    "id": "https://genegraph.clinicalgenome.org/r/0087c979-8cb6-4959-bc64-07a48a61983b",
    "type": "Family",
    "rdfs:label": "Strobl-Wildemann - Segregation Scoring"
  },
  "meetsInclusionCriteria": true,         # Tristan clarified that this indicates whether the co-segregation is significant/useful to use as evidence or not. If not, they want to report it was looked at but not used as evidence. 
  "phenotype": {
    "id": "obo:HP_0001249"
  },
  "phenotypePositiveAllelePositive": 8,
  "publishedLodScore": 2.41,
  "sequencingMethod": {
    "id": "cg:CandidateGeneSequencing"
  }
},


# Matt's SEPIO proposal - representation as a Study Result
{
  "id": "https://genegraph.clinicalgenome.org/r/0087c979-8cb6-4959-bc64-07a48a61983b_family_segregation",
  "type": "FamilyCosegregationStudyResult",              # This (and all similar objects below) would likely be representable by a new SEPIO/VA StudyResult subtype, which we could define to capture the info below
  "rdfs:label": "Strobl-Wildemann - Segregation Scoring",
  "description": "Sequenced more than 1 gene on the X, higher than just candidate gene sequencing",
  "reportedIn": "https://pubmed.ncbi.nlm.nih.gov/22002931",
  "focus": {                                              # Note that we might consider allowing for more than one focus of a Study Result (to capture the focus variant here as well)
    "primaryCoding": "obo:HP_0001249"
    "description": "..."                                   # would capture content of "CG:phenotypeFreeText"
  },
  "studyGroup": {
    "id": "https://genegraph.clinicalgenome.org/r/0087c979-8cb6-4959-bc64-07a48a61983b",
    "type": "Family",
    "label": "Strobl-Wildemann - Segregation Scoring"
    "probands": "..."       # no data provided in this example, but including to show that this is where we would report this - in the Family, not the StudyResult 
  },
  "lodScore": 2.41,                                       # new property created for a data item specific to this type of Study Result
  "phenotypePositiveAllelePositive": 8,                   # new property created for  data item specific to this type of Study Result. Schema says this is boolean . . . why is value here "8"?
  "supportingMethodType": "cg:CandidateGeneSequencing"    # alt, capture as a quality measure?
  }
}

# I think the "meetsInclusionCriteria" data is handled by the "directionOfEvidenceProvided" attribute in the parent EvidenceLine. - which would be "supports" if true, and "neutral" if false (because in this case the cosegregation data does not provide evidence in either direction)


