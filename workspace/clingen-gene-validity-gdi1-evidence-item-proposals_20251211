# Matt's proposed SEPIO representation as a Statement
# I do think the variant/allele being interrogated should be captured in these objects.  Would the subject of a Statement, or the 'focus' of a StudyResult

# Proposed Statement Structure 1 (parallels MAVE Functional Impact Statement SPOQ for describing variant impact on protein function)
   {
    "id": "https://genegraph.clinicalgenome.org/r/23ee3af1-ac4e-42fd-b756-79ec36dee819_CellularImpact_evidence_item",
    "type": "CellularImpactStatement",
    "description": "Using electron microscopy and electrophysiology, we now report that ..."
    "proposition": {
      "subject": https://genegraph.clinicalgenome.org/r/b152381d-b705-4ef5-93ba-bfd27d966769",
      "predicate": "impactsFunctionOf",
      "object": "CL:0002604",                   # Hippocampal Astrocyte
      "impactTypeQualifier": "GO:0048400",      # synaptic vesicle membrane organization
      "experimentalContextQualifier": "https://pubmed.ncbi.nlm.nih.gov/22291864"   # optional - a way to narrow the scope/remit of this statement (i.e. that that it holds in a specific experimental context, as described in the referenced pub)
    },
    "direction": supports                  
    "classification": "abnormal function"  # optional - value here can be whatever the ClinGen community wants this to be
  },

# Proposed Statement Structure 2 (A more natural way to structure this IMO, with the affected GO term as the object, and cell context as a qualifier

   {
    "id": "https://genegraph.clinicalgenome.org/r/23ee3af1-ac4e-42fd-b756-79ec36dee819_CellularImpact_evidence_item",
    "type": "CellularImpactStatement",
    "description": "Using electron microscopy and electrophysiology, we now report that ...",
    "proposition": {
      "subject": https://genegraph.clinicalgenome.org/r/b152381d-b705-4ef5-93ba-bfd27d966769",
      "predicate": "disrupts",
      "object": "GO:0048400",                           # synaptic vesicle membrane organization
      "cellularContextQualifier": "CL:0002604",         # Hippocampal Astrocyte
      "experimentalContextQualifier": "https://pubmed.ncbi.nlm.nih.gov/22291864"   # optional - a way to narrow the scope/remit of this statement (i.e. that that it holds in a specific experimental context, as described in the referenced pub)
    },
    "direction": supports                  
    "classification": "abnormal synaptic vesicle membrane organization"  # optional - value here can be whatever the ClinGen community wants this to be
  },

# Proposed Statement Structure 3 - these are really just ways to say that the variant causes a specific cellular phenotype. There has been work to "phenotypify" all go terms automatically by combining their CURIES with the PATO curie for abnormal (PATO:0000460) - e.g. "PATO:0000460GO:0048400" 


   {
    "id": "https://genegraph.clinicalgenome.org/r/23ee3af1-ac4e-42fd-b756-79ec36dee819_CellularImpact_evidence_item",
    "type": "CellularImpactStatement",
    "description": "Using electron microscopy and electrophysiology, we now report that ...",
    "proposition": {
      "subject": https://genegraph.clinicalgenome.org/r/b152381d-b705-4ef5-93ba-bfd27d966769",
      "predicate": "has_phenotype",
      "object": "PATO:0000460GO:0048400" ,              # abnormal (PATO:0000460) synaptic vesicle membrane organization (GO:0048400)
      "cellularContextQualifier": "CL:0002604",         # Hippocampal Astrocyte (note that ClinGen may also want to report that this is a cell line, and whether it is patient derived or not, so may need some more modeling here, or capture this as provenance metadata)
      "experimentalContextQualifier": "https://pubmed.ncbi.nlm.nih.gov/22291864"   # optional - a way to narrow the scope/remit of this statement (i.e. that that it holds in a specific experimental context, as described in the referenced pub)
    },
    "direction": supports                  
    "classification": "abnormal synaptic vesicle membrane organization"  # optional - value here can be whatever the ClinGen community wants this to be
  },



