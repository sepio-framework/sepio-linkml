example:sepio-model\/Activity a sh:NodeShape ;
	rdfs:comment "An action or set of actions performed by an agent, that occurs over a period of time. Activities may use, generate, modify, move, or destroy one or more entities." ;
	rdfs:label "Activity" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n98 ;
	sh:property _:c14n114 , _:c14n142 , _:c14n165 , _:c14n181 , _:c14n183 , _:c14n186 , _:c14n197 , _:c14n255 , _:c14n301 , _:c14n318 , _:c14n323 , _:c14n35 , _:c14n4 ;
	sh:targetClass example:sepio-model\/Activity .
example:sepio-model\/Agent a sh:NodeShape ;
	rdfs:comment "An autonomous actor (person, organization, or software agent) that bears some form of responsibility for an activity taking place,  for the existence of an entity, or for another agent's activity." ;
	rdfs:label "Agent" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n37 ;
