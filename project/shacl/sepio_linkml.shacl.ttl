example:sepio-model\/Extension a sh:NodeShape ;
	rdfs:comment "A data structure that allows custom attributes to be defined for an Entity, to capture information unique to a given content provider, or not currently supported by the core specification." ;
	rdfs:label "Extension" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n219 ;
	sh:property _:c14n164 , _:c14n222 , _:c14n49 ;
