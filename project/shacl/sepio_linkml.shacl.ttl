	sh:targetClass example:sepio-model\/Statement .
example:sepio-model\/StudyGroup a sh:NodeShape ;
	rdfs:comment "A collection of individuals or specimens from the same taxonomic class, selected for analysis in a scientific study based on their exhibiting one or more common characteristics  (e.g. species, race, age, gender, disease state, income). May be referred to as a 'cohort' or 'population' in specific research settings." ;
	rdfs:label "Study Group" ;
	sh:closed true ;
