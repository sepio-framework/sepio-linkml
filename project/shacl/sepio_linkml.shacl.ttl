example:sepio-model\/Qualifier a sh:NodeShape ;
	rdfs:comment "A key-value object used to capture additional piece of information that extends or refines the meaning of a Statement's core subject - predicate - object 'triple' - by providing additional detail, or constraining the statement to apply in a particular context." ;
	rdfs:label "Qualifier" ;
	sh:closed true ;
