example:sepio-model\/Statement a sh:NodeShape ;
	rdfs:comment "A claim of purported truth as made by a particular agent, on a particular occasion. Statements may be used to simply put forth a possible fact (i.e. a 'proposition') as true, or to provide a more nuanced assessment of the level of confidence or evidence supporting a particular proposition." ;
	rdfs:label "Statement" ;
	sh:closed true ;
