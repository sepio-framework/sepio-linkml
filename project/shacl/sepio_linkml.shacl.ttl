	sh:targetClass example:sepio-model\/EvidenceLine .
example:sepio-model\/Expression a sh:NodeShape ;
	rdfs:comment "A structure for labels representing systematic expressions that describe an entity, as generated by formal nomenclatures (e.g. HGVS for genetic variants, ISCN for karyotypes, HLA nomenclature for HLA genes/alleles)." ;
	rdfs:label "Expression" ;
	sh:closed true ;
