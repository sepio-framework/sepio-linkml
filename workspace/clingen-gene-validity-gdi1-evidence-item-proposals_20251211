# 2. Variant Functional Impact Evidence

# Original ClinGen Data
{
  "id": "https://genegraph.clinicalgenome.org/r/23ee3af1-ac4e-42fd-b756-79ec36dee819_function_evidence_item",
  "type": "VariantFunctionalImpactEvidence",  # This would likely be represented as an ExperimentalFunctionalImpactStudyResult in SEPIO/VA.  MAVE defined a model of this for their use case, which may need to be expanded to support yours.  
  "dc:description": "Western blot shows no GDI1 protein expression in affected patient.",
  "functionalDataSupport": "Yes"              # Not supported by SEPIO/VA -  but if this is really needed? it seems to just indicate 'yes' if there is functional impact data bout the observed variant - but it lives in the FunctionalImpactEvidence object, which wouldn;t be created if there was not functional evidence.
},

# Matt's SEPIO proposals - representation as a SEPIO Study Result vs a Statement

# Proposal 1: Use the existing EVFI Study Result or Statement (as defined in VA-Spec) to make a simple Result object. Simplest, minimal new data required.  
# But I think what is being reported here is the conclusion of the experiment (not the data from it) - which is more of a Statement. 
# For this reason I think we favor Proposal 2 below.
 {
    "id": "https://genegraph.clinicalgenome.org/r/23ee3af1-ac4e-42fd-b756-79ec36dee819_function_evidence_item",
    "type": "ExperimentalVariantFunctionalImpactStudyResult",                                            # Already defined in VA-Spec for the MAVE use case - so we will want to re-use / be consistent with this
    "description": "Western blot shows no GDI1 protein expression in affected patient.",  
    "focus": https://genegraph.clinicalgenome.org/r/b152381d-b705-4ef5-93ba-bfd27d966769",    # this is required in a SEPIO/VA study result
#  ... could add more fields to structure additional data as desired, e.g. "supportingMethodType": "Western Blot". But as noted - there doesnt seem to be any actual data items from the experiment reported, so this doesn't feel like a Study Result. 
  },


# Proposal 2 (preferred): We make this an EVFI Statement - using existing VA-Spec model/profile. 
# Fits well with the use case, and aligns with what VA-Spec/MAVE have done here. But requires ClinGen to create some additional structured data.  
   {
    "id": "https://genegraph.clinicalgenome.org/r/23ee3af1-ac4e-42fd-b756-79ec36dee819_function_evidence_item",
    "type": "ExperimentalVariantFunctionalImpactStatement",
    "description": "Western blot shows no GDI1 protein expression in affected patient.",
    "proposition": {
      "subjectVariant": https://genegraph.clinicalgenome.org/r/b152381d-b705-4ef5-93ba-bfd27d966769",
      "predicate": "impactsFunctionOf",
      "objectSequenceFeature": "hgnc:4226",
      "experimentalContextQualifier": "https://pubmed.ncbi.nlm.nih.gov/22002931"   # optional - a way to narrow the scope/remit of this statement (i.e. that that it holds in a specific experimental context, as described in the referenced pub)
      "impactTypeQualifier": "reduced expression",    # optional - a way that the reported impact might be captured in a structured way, but not necessary.
    },
    "direction": supports                  
    "classification": "abnormal function"  # optional  - value here can be whatever the ClinGen community wants this to be
  },
  
  
  # TO DO: Look at other examples of VariantFunctionalImpactEvidence objects in the ClinGen data, and assess how each proposal handles them
  
  
